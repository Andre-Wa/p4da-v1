# --- Target ---
CONFIG_IDF_TARGET="esp32p4"

# --- PSRAM (32MB HEX) ---
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Renomeado no IDF 5.5 (era CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY).
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# --- Banda/perf p/ MIPI-DSI ---
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- Flash (16MB) + partições ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- SD card (nomes longos + UTF-8 p/ acentos) ---
# Nota: no IDF 5.5 "FATFS_LONG_FILENAMES" virou choice; o membro válido é
# FATFS_LFN_HEAP. A linha antiga era ignorada com warning no configure.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# --- USB-OTG (host p/ teclado + áudio) ---
# M5a.1 (2026-10-07): 256 era o teto da era só-teclado; o QCY H3s (composite
# BT+UAC) tem config descriptor MAIOR que 256 B e a enumeração morria em
# CHECK_SHORT_CONFIG_DESC. 1024 cobre devices de áudio compostos;
# custo = 1 KB de buffer de control transfer.
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024
CONFIG_USB_OTG_SUPPORTED=y

# --- LCD ---
CONFIG_LCD_ENABLE_DEBUG_LOG=n

# --- FreeRTOS / tarefas ---
CONFIG_FREERTOS_HZ=1000
# A task main só faz o bring-up: o event loop/layout do Slint mora na
# task ui_loop (pilha 32K em PSRAM, ver main.cpp). 8K internos bastam e
# aliviam o boot depois que o ESP-Hosted passou a alocar cedo.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# --- Power management (standby/light sleep — ver docs/POWER.md) ---
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# --- ESP-Hosted (C6/SDIO): alívio de RAM interna no boot ---
# O hosted init roda como hook de startup, ANTES da task main; sem isso ele
# esgota o heap interno e o assert de app_startup.c:86 derruba o boot
# (observado em 2026-09-24). Pilhas das tasks do hosted -> PSRAM e filas
# SDIO menores (cada slot = buffer DMA interno).
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=10
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=10

# --- SNTP (relógio via NTP no C6) ---
CONFIG_LWIP_SNTP=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# --- C++ (Slint) ---
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y
