// screens/notes.slint — lista de notas
import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { TonalButton, GhostButton } from "../elements/buttons.slint";
import { Surface, ScreenTitle } from "../elements/surfaces.slint";

export component NotesListScreen inherits Rectangle {
    in property <[string]> notes;
    callback go-back();
    callback open-note(string);
    callback new-note();

    VerticalLayout {
        padding: Theme.sp-lg;
        spacing: Theme.sp-md;

        HorizontalLayout {
            spacing: Theme.sp-sm;
            ScreenTitle { label: "Notas"; horizontal-stretch: 1; }
            TonalButton { width: 120px; text: "+ Nova nota"; fsize: Theme.type-label; clicked => { root.new-note(); } }
            GhostButton { width: 90px; text: "Voltar"; fsize: Theme.type-label; clicked => { root.go-back(); } }
        }

        Surface {
            level: 1;
            vertical-stretch: 1;
            clip: true;

            ListView {
                width: 100%;
                height: 100%;
                for note in root.notes: Rectangle {
                    height: 44px;
                    clip: true;
                    Text {
                        x: Theme.sp-md;
                        text: note;
                        color: Theme.on-primary-container;
                        font-size: Theme.type-body;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: Theme.state-pressed;
                        visible: ta.pressed;
                        border-radius: Theme.shape-sm;
                        opacity: 10%;
                    }
                    ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.open-note(note); }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.outline-var; }
                }
            }
        }
    }
}
