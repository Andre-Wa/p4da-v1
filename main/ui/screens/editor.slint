// screens/editor.slint — editor com scroll VIRTUALIZADO próprio (sem Flickable)
//
// O C++ é dono da posição (s_ed_top/s_ed_left); a UI renderiza só a fatia
// visível + um offset pixel. Isso elimina os resets de viewport do
// Flickable/Slint 1.12 (bug reportado 4x) e virtualiza arquivos grandes
// (M3c). Gestos: arrastar = scroll; toque = cursor na linha/coluna
// (fonte mono => coluna por largura de caractere).
import { Theme } from "../theme.slint";
import { FilledButton, TonalButton, DangerButton, GhostButton } from "../elements/buttons.slint";
import { Surface } from "../elements/surfaces.slint";
import { OnScreenKeyboard } from "../elements/osk.slint";
import "../assets/RobotoMono-Subset.ttf";

export component EditorScreen inherits Rectangle {
    in property <string> title;
    in property <[string]> lines;        // fatia visível
    in property <length> offset;         // deslocamento pixel da fatia
    in property <length> offset-x;
    in property <length> content-w: 780px;
    in property <bool> dirty;
    in property <bool> can-delete;
    in property <bool> show-osk;
    in property <bool> osk-shift;
    in property <bool> osk-mode;
    in property <[string]> osk-r1;
    in property <[string]> osk-r2;
    in property <[string]> osk-r3;
    in-out property <length> last-x: 0px;
    in-out property <length> last-y: 0px;
    in-out property <length> drag-dist: 0px;
    callback drag(float, float);
    callback tap-at(float, float);
    callback osk-key(string);
    callback osk-shift-changed(bool);
    callback save();
    callback delete-file();
    callback toggle-osk();
    callback go-back();

    VerticalLayout {
        padding: Theme.sp-sm;
        spacing: 6px;

        HorizontalLayout {
            spacing: Theme.sp-sm;
            Text {
                text: root.title + (root.dirty ? " *" : "");
                font-size: Theme.type-title;
                font-weight: 700;
                color: root.dirty ? Theme.tertiary : Theme.on-surface;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            FilledButton { width: 80px; h: Theme.btn-h-sm; fsize: Theme.type-label; text: "Salvar"; clicked => { root.save(); } }
            if root.can-delete: DangerButton { width: 80px; h: Theme.btn-h-sm; fsize: Theme.type-label; text: "Apagar"; clicked => { root.delete-file(); } }
            TonalButton { width: 80px; h: Theme.btn-h-sm; fsize: Theme.type-label; text: "Tecl"; clicked => { root.toggle-osk(); } }
            GhostButton { width: 80px; h: Theme.btn-h-sm; fsize: Theme.type-label; text: "Voltar"; clicked => { root.go-back(); } }
        }

        Surface {
            level: 1;
            vertical-stretch: 1;
            clip: true;

            Rectangle {
                y: -1 * root.offset;
                x: -1 * root.offset-x;
                width: root.content-w;
                VerticalLayout {
                    spacing: 0px;
                    for line in root.lines: Rectangle {
                        height: Theme.line-h;
                        width: root.content-w;
                        Text {
                            x: 6px;
                            text: line;
                            font-family: "Roboto Mono";
                            font-size: Theme.type-body;
                            color: Theme.on-surface;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }

            TouchArea {
                width: 100%;
                height: 100%;
                changed pressed => {
                    if (self.pressed) {
                        root.last-x = self.mouse-x;
                        root.last-y = self.mouse-y;
                        root.drag-dist = 0px;
                    }
                }
                moved => {
                    root.drag-dist = root.drag-dist
                        + Math.abs(self.mouse-x - root.last-x)
                        + Math.abs(self.mouse-y - root.last-y);
                    root.drag((self.mouse-x - root.last-x) / 1px,
                              (self.mouse-y - root.last-y) / 1px);
                    root.last-x = self.mouse-x;
                    root.last-y = self.mouse-y;
                }
                clicked => {
                    // só posiciona cursor se foi toque, não drag de scroll
                    if (root.drag-dist < 8px) {
                        root.tap-at(self.mouse-x / 1px, self.mouse-y / 1px);
                    }
                }
            }
        }

        if root.show-osk: OnScreenKeyboard {
            height: Theme.osk-h;
            r1: root.osk-r1;
            r2: root.osk-r2;
            r3: root.osk-r3;
            shift: root.osk-shift;
            mode: root.osk-mode;
            key(k) => { root.osk-key(k); }
            shift-changed(s) => { root.osk-shift-changed(s); }
        }
    }
}
