// elements/buttons.slint — família de botões do design system
//
// Variantes M3 adaptadas: filled (ação primária), tonal (secundária),
// danger (destrutiva), ghost (neutra/contorno). State layer de pressed
// por cima, como no Material.
import { Theme } from "../theme.slint";

export component FilledButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> h: Theme.btn-h;
    in property <length> fsize: Theme.type-body;
    callback clicked;

    height: root.h;
    border-radius: Theme.shape-lg;
    background: root.enabled ? Theme.primary : Theme.surface-2;
    clip: true;

    Text {
        text: root.text;
        font-size: root.fsize;
        font-weight: 700;
        color: root.enabled ? Theme.on-primary : Theme.on-surface-var;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.state-pressed;
        visible: ta.pressed && root.enabled;
        border-radius: Theme.shape-sm;
        opacity: 10%;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component TonalButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> h: Theme.btn-h;
    in property <length> fsize: Theme.type-body;
    callback clicked;

