    border-radius: Theme.shape-lg;
    background: root.enabled ? Theme.secondary-container : Theme.surface-2;
    clip: true;

    Text {
        text: root.text;
        font-size: root.fsize;
        color: root.enabled ? Theme.on-secondary-container : Theme.on-surface-var;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.state-pressed;
        visible: ta.pressed && root.enabled;
        border-radius: Theme.shape-sm;
        opacity: 10%;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
