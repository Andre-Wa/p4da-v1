// elements/icons.slint — ícones Material Icons (Apache-2.0, subset)
//
// Subset pré-gerado (3,4 KB) por tools/make_icons.sh; glifos são
// pré-rasterizados no compile como qualquer fonte estática.
// Para adicionar ícone: tools/icons.json -> make_icons.sh -> wrapper aqui.
import { Theme } from "../theme.slint";
import "../assets/MaterialIcons-Subset.ttf";

// Ícone por CATEGORIA vinda do C++ ("dir","lua","sh","audio","img","txt",
// "sd","int", ...). Os codepoints PRECISAM ser literais estáticos aqui:
// o renderer pré-rasteriza só o que aparece no .slint — codepoint enviado
// em runtime do C++ renderiza em branco (avanço reservado, glifo ausente).
export component IconForKind inherits Text {
    in property <string> kind;
    in property <length> size: Theme.type-title;
    in property <color> tint: Theme.on-surface-var;
    text: root.kind == "dir"   ? ""
        : root.kind == "lua"   ? ""
        : root.kind == "sh"    ? ""
        : root.kind == "audio" ? ""
        : root.kind == "img"   ? ""
        : root.kind == "txt"   ? ""
        : root.kind == "sd"    ? ""
        : "";
    font-family: "Material Icons";
    font-size: root.size;
    color: root.tint;
    vertical-alignment: center;
}

